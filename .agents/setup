#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1" start=$SECONDS
  shift
  printf '\n==> %s\n' "$label"
  "$@"
  printf '==> %s finished in %ss\n' "$label" "$((SECONDS - start))"
}

# Use the orb's preinstalled toolchain; no virtualenv activation is required.
python3 -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11+ required"'
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 20 || (major === 20 && minor < 9)) throw Error("Node.js 20.9+ required")'
python3 --version
node --version
# pnpm 12 changed build-script policy; keep the version compatible with the
# repository's pnpm-workspace.yaml and lockfile.
if [[ "$(pnpm --version)" != "10.28.2" ]]; then
  step "pnpm toolchain" npm install --global pnpm@10.28.2 --no-audit --no-fund
fi
pnpm --version

step "Python dependencies" uv pip install --system --python "$(command -v python3)" -r requirements.txt
step "Playwright Chromium" python3 -m playwright install chromium

# The base orb normally has browser libraries. Only run apt when one is missing.
chromium="$(python3 -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); print(p.chromium.executable_path); p.stop()')"
if ldd "$chromium" | grep 'not found' > /dev/null; then
  step "Chromium system dependencies" python3 -m playwright install-deps chromium
fi

step "Web dependencies" env CI=true pnpm --dir web install --frozen-lockfile

printf '\nOrb dependencies ready. Run tests with python3 -m pytest tests/.\n'
printf 'Start the web preview with amp orb services ensure.\n'
